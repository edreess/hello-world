<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_imposition" model="ir.module.category">
        <field name="name">Imposition</field>
        <field name="description">Offset imposition planning</field>
        <field name="sequence">25</field>
    </record>

    <!-- Odoo 19: groups are organized under privileges (res.groups.privilege)
         instead of the removed res.groups.category_id field. -->
    <record id="privilege_imposition" model="res.groups.privilege">
        <field name="name">Imposition</field>
        <field name="category_id" ref="module_category_imposition"/>
        <field name="sequence">25</field>
    </record>

    <record id="group_imposition_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_imposition"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_imposition_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_imposition"/>
        <field name="implied_ids" eval="[(4, ref('group_imposition_user'))]"/>
    </record>

    <!-- Grant the default administrator the Manager level on install so
         the Imposition menu is immediately visible. -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_imposition_manager'))]"/>
    </record>
</odoo>
