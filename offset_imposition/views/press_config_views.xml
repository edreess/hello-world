<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="press_config_view_list" model="ir.ui.view">
        <field name="name">press.config.list</field>
        <field name="model">press.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="manufacturer" optional="show"/>
                <field name="plate_width"/>
                <field name="plate_height"/>
                <field name="max_sheet_width"/>
                <field name="max_sheet_height"/>
                <field name="num_units"/>
                <field name="is_perfecting" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="press_config_view_form" model="ir.ui.view">
        <field name="name">press.config.form</field>
        <field name="model">press.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Speedmaster SM 74"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="active" invisible="1"/>
                            <field name="code"/>
                            <field name="manufacturer"/>
                            <field name="num_units"/>
                            <field name="is_perfecting"/>
                        </group>
                        <group string="Plate (mm)">
                            <field name="plate_width"/>
                            <field name="plate_height"/>
                            <field name="plate_bend_margin"/>
                        </group>
                        <group string="Sheet Limits (mm)">
                            <field name="max_sheet_width"/>
                            <field name="max_sheet_height"/>
                            <field name="min_sheet_width"/>
                            <field name="min_sheet_height"/>
                        </group>
                        <group string="Non-Printable Margins (mm)">
                            <field name="gripper_margin"/>
                            <field name="side_lay_margin"/>
                            <field name="tail_margin"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="press_config_action" model="ir.actions.act_window">
        <field name="name">Presses</field>
        <field name="res_model">press.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure your first offset press</p>
            <p>Define the plate size, sheet limits and gripper margins used by the imposition planner.</p>
        </field>
    </record>
</odoo>
